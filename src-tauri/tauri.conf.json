{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Qamuz Studio",
  "version": "2.0.0",
  "identifier": "com.genaudius.qamuzstudio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Qamuz Studio",
        "width": 1500,
        "height": 940,
        "minWidth": 1200,
        "minHeight": 700,
        "resizable": true,
        "center": true,
        "theme": "Dark",
        "titleBarStyle": "Visible",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "Cross-platform DAW with AI-assisted writing",
    "longDescription": "Qamuz Studio is a digital audio workstation for Windows and macOS with a timeline, piano roll, mixer and AI-assisted audio and MIDI generation.",
    "copyright": "Copyright (c) 2026 GenAudius",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["dawproj"],
        "name": "Qamuz Studio Project",
        "description": "Qamuz Studio project package",
        "role": "Editor"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
